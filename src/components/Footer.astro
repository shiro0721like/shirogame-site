---
import { NAV, SITE } from '../data/site';

/** 构建时间按北京时间显示。 */
const builtAt = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
})
  .format(new Date())
  .replace(/\//g, '-');
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div>
      <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="14" fill="#0b131c"></rect>
          <g fill="none" stroke="#8dff6e" stroke-width="5" stroke-linecap="square">
            <path d="M16 28V16h12"></path>
            <path d="M36 16h12v12"></path>
            <path d="M48 36v12H36"></path>
            <path d="M28 48H16V36"></path>
          </g>
          <rect x="26" y="26" width="12" height="12" fill="#4dd4ff"></rect>
        </svg>
        {SITE.name}
      </a>
      <p>我做的游戏的陈列窗与下载站。</p>
    </div>
    <div>
      <h2>站内</h2>
      <ul>
        {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2>可以直接玩的</h2>
      <ul>
        <li>
          <a href={SITE.gameServer.url} target="_blank" rel="noopener">
            {SITE.gameServer.label} ↗
          </a>
        </li>
      </ul>
    </div>
    <div class="footer-note">
      <span>© {year} shirogame.top</span>
      <span>构建于 <span class="mono">{builtAt}</span>（UTC+8）</span>
    </div>
  </div>
</footer>
