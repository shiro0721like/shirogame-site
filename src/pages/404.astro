---
import Base from '../layouts/Base.astro';
---

<Base title="找不到这个页面" description="你要找的页面不存在。" noindex>
  <div class="container">
    <div class="notfound">
      <span class="code">404</span>
      <h1>找不到这个页面</h1>
      <p>地址可能写错了，或者这个页面已经挪走了。</p>
      <div class="hero-actions">
        <a class="btn btn--primary" href="/">返回首页</a>
        <a class="btn" href="/games/">看作品</a>
      </div>
    </div>
  </div>
</Base>
